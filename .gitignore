# CivicSense

## Project Root .gitignore

# ── Node ──────────────────────────────────────────────────────
node_modules/

# ── Environment ───────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Uploaded files ────────────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

# ── Frontend build ────────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# ── IDE ───────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
